---
import { SITE } from "@/config";
import { Image } from "astro:assets";
import logo from '../assets/network.svg';

---

<div id="container">
	<main>
		<section id="hero" class="text-white bg-black h-screen text-center content-center">
			<Image src={logo} alt="Monopolies.net Logo" class="inline"/>
			<h1>
				{ SITE.title }
			</h1>
			<section id="home-description" class="text-xl">
				{ SITE.description }
			</section>
		</section>
	</main>

</div>