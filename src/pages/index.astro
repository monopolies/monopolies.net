---
import { getCollection } from "astro:content";
import Monopoly from '../components/Monopoly.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';

const bigTech = (await getCollection('companies', ({ data }) => {
  return data.big_tech;
}));

---
<Layout>
	<Header />
	 {bigTech.map(bigTech => (
		<Monopoly {...bigTech}/>
	))}
	<Footer />
</Layout>
